{
  "manifest_version": 3,
  "name": "Ninja Listening Trainer for YouTube",
  "version": "0.1.0",
  "description": "Mark a YouTube fragment and replay it through a customizable speed/subtitle sequence for listening and pronunciation practice.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Ninja Listening Trainer",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ninja-listening-trainer@kouichi.example",
      "strict_min_version": "109.0"
    }
  }
}
